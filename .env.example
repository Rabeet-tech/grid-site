# Admin API token (min 16 chars). Generate one with: python -m app.cli token
# If unset, every /api/admin/* route answers 503, so nothing is exposed by accident.
ADMIN_TOKEN=

# Optional
# GRID_DB=data/grid.db
# GRID_PHOTO_DIR=static/photos
# GRID_DOCS=0          # set to 0 to hide /docs and /openapi.json in production
